# ---------- backend (prefix PK_) ----------
# SQLite (default, zero setup):
# PK_DATABASE_URL=sqlite:///./var/pushkaralu.db
# PostgreSQL + PostGIS (docker compose sets this automatically):
# PK_DATABASE_URL=postgresql+psycopg://pushkaralu:pushkaralu@localhost:5432/pushkaralu
PK_RESULTS_DIR=./var/results
PK_UPLOAD_DIR=./var/uploads
# Concurrent simulations (each runs in its own worker process)
PK_MAX_WORKERS=2
# Safety limits for a single run
PK_MAX_AGENTS=20000
PK_MAX_DURATION_S=14400
# Load the synthetic demo site and the OSM reference layer on first start
PK_SEED_DEMO_DATA=true
PK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- frontend (Vite, prefix VITE_) ----------
# Optional custom XYZ basemap (otherwise OpenStreetMap tiles for real sites, grid for synthetic)
# VITE_BASEMAP_URL=https://tiles.example.org/{z}/{x}/{y}.png
# VITE_BASEMAP_ATTRIBUTION=(c) Example basemap provider
# Where the dev server proxies /api to
# VITE_API_PROXY=http://127.0.0.1:8000

# ---------- docker compose ----------
POSTGRES_USER=pushkaralu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pushkaralu
GEOSERVER_ADMIN_PASSWORD=change-me
